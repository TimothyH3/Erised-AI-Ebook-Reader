# ==============================================================================
# Erised AI • Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting local development:
#   cp .env.example .env
#
# Erised AI supports three distinct operational modes:
#   1. Zero-Key Headless Mode (Default): Uses your active Google Gemini consumer session.
#   2. Local Offline Mode: Zero cloud telemetry; runs via local Ollama / vLLM.
#   3. Direct Cloud API Mode: Connects directly to Google, OpenAI, or Anthropic.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Engine Selection
# ------------------------------------------------------------------------------
# Options: 'gemini' (Zero-Key Headless Google Session), 'pollinations' (Flux.1),
#          'local_llm' (Ollama/vLLM), 'openai', 'anthropic'
AI_SYNTHESIS_ENGINE=gemini

# ------------------------------------------------------------------------------
# 2. Local Privacy Engine (Ollama / vLLM / LocalAI)
# ------------------------------------------------------------------------------
# No API keys or cloud telemetry required. Start your local Ollama instance:
#   ollama run llama3.2
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=llama3.2
LOCAL_EMBEDDING_ENDPOINT=http://localhost:11434
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 3. Optional Direct Cloud API Keys (BYOK Mode)
# ------------------------------------------------------------------------------
# Leave blank to use zero-cost headless Gemini mode out of the box.
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloud Model Overrides
OPENAI_COMPLETION_MODEL=gpt-4o-mini
ANTHROPIC_COMPLETION_MODEL=claude-3-5-haiku-latest
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 4. Reader Defaults & Typography Settings
# ------------------------------------------------------------------------------
DEFAULT_READER_THEME=obsidian
DEFAULT_FONT_SIZE=18
DEFAULT_ART_STYLE=chiaroscuro_oil
DEFAULT_ASPECT_RATIO=4:3
SYNTHESIS_PAGE_DWELL_MS=4000

